# ============================================================
#  Meshubatzim – environment configuration (TEMPLATE)
#  Copy to ".env" and fill in real values. ".env" is NOT committed.
# ============================================================

# ---- Core ----
GROUP_ID=replace-with-a-long-random-value
APP_ENV=development                 # development | production
SECRET_KEY=change-me-to-a-long-random-string
APP_TITLE=לוח שיבוצים שבועי 
TIMEZONE=Asia/Jerusalem

# ---- Database ----
# Local development (SQLite, zero-config):
DATABASE_URL=sqlite:///meshubatzim.sqlite3
# Production (managed Postgres – Neon / Supabase), example:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Editing access ----
# OPEN_EDIT=true  -> editing is open to everyone (no password); login stays but
#                    is inactive. Set to false + EDIT_PASSWORD to re-gate editing.
OPEN_EDIT=true
EDIT_PASSWORD=change-me

# ---- Scheduling rules ----
MAX_WEEKS_AHEAD=4                   # how many weeks ahead may be created
ACTIVE_DAYS=0,1,2,3,4,5,6           # 0=Sunday ... 6=Saturday
# Shifts are configurable (count + identity). JSON array of:
#   name (stored key), label (shown), start/end ("HH:MM"). Add/remove freely.
SHIFTS='[{"name":"morning","label":"08:00–14:00","start":"08:00","end":"14:00"},{"name":"evening","label":"14:00–20:00","start":"14:00","end":"20:00"}]'

# ---- Highlighted notes (banners on top of the board) ----
# JSON array of objects. Per note: text (required),
#   type = danger | warning | info | success | note  (success = green),
#   h    = 1..6 (optional heading size). Add as many as you like.
IMPORTANT_NOTE='[]'

# ---- Optional slot-linking rules ----
# JSON array. Each rule links cells; when any target is edited the action is
# applied to the rest. action=mirror copies the same name+notes to all targets.
# day: 0=Sun..6=Sat, shift: morning|evening. Rules are best-effort (a failure
# is logged and skipped, never breaks a save). Example below links Friday
# evening + both Shabbat shifts.
RULES='[{"name":"שישי בערב ושבת","action":"mirror","targets":[{"day":5,"shift":"evening"},{"day":6,"shift":"morning"},{"day":6,"shift":"evening"}]}]'

# ---- Realtime (SocketIO) ----
SOCKETIO_ASYNC_MODE=threading
# REDIS_URL=redis://localhost:6379/0   # only needed to scale beyond 1 instance

# ---- Logging ----
LOG_REQUESTS=true
LOG_SKIP_PREFIXES=/static,/socket.io,/favicon
LOG_LEVEL=INFO
